# GENERATED by scripts/render-packaging.sh from the gominimal/minimal packaging
# templates — do not hand edit in the tap. Nightly formula: assets come from
# the installer-bucket staged row (versions/<short-sha>/), not a GitHub
# Release. version is the synthetic pkgver 0.YYYYMMDD.run; binaries report a
# git-describe string, so the test asserts --help rather than --version.
class MinimalNightly < Formula
  desc "Isolated, reproducible development environments and a secure package manager (nightly)"
  homepage "https://minimal.dev"
  license "Apache-2.0"
  version "@@VERSION@@"
  url "@@BUCKET_URL@@/versions/@@STAGE_VERSION@@/minimal-macos-arm64"
  sha256 "@@SHA256@@"

  # The macOS release is Apple Silicon only (no darwin x86_64 artifact exists).
  depends_on arch: :arm64

  # macOS VM support. minvmd links libkrun via @rpath/libkrun.1.dylib and
  # carries an @loader_path/../lib rpath (scripts/rewrite-macos-linkage.sh
  # retargets the release binary to exactly that shape), so it resolves the
  # library from THIS prefix's lib/ — a Cellar prefix sibling of bin/, not the
  # slp/krun formula's Cellar, which @loader_path can never reach. depends_on
  # pulls the formula in and gives the dylib its runtime deps; the resource
  # below installs the same trimmed dylib the installer drops (libkrun
  # -macos-arm64.dylib from the release assets) under the load command's
  # expected name, reproducing the installer's bin/lib sibling layout.
  depends_on "slp/krun/libkrun"

  resource "minvmd" do
    url "@@BUCKET_URL@@/versions/@@STAGE_VERSION@@/minvmd-macos-arm64"
    sha256 "@@SHA_MINVMD@@"
  end

  # The libkrun dylib minvmd loads. Basename MUST be libkrun.1.dylib: that is
  # minvmd's @rpath load command (see scripts/stage-release.sh's darwin table).
  resource "libkrun" do
    url "@@BUCKET_URL@@/versions/@@STAGE_VERSION@@/libkrun-macos-arm64.dylib"
    sha256 "@@SHA_LIBKRUN@@"
  end

  resource "gvproxy" do
    url "@@BUCKET_URL@@/versions/@@STAGE_VERSION@@/gvproxy-darwin-arm64"
    sha256 "@@SHA_GVPROXY@@"
  end

  def install
    # The release asset minimal-macos-arm64 is the `min` binary (the bin
    # target of the `minimal` crate, named for the crate in the release);
    # the installer installs it as `bin/min`. The hash form renames on
    # install: `bin.install "minimal-macos-arm64"` (no hash) would create a
    # directory named min/ with the binary inside it.
    bin.install "minimal-macos-arm64" => "min"

    # `git push min://<session>` resolves the min:// scheme to a
    # `git-remote-min` on PATH; `min` enters remote-helper mode from its
    # argv[0] basename, so the symlink to `min` is the whole helper — the
    # installer ships the same symlink with no separate artifact.
    ln_sf "min", bin/"git-remote-min"

    resource("minvmd").stage do
      bin.install "minvmd-macos-arm64" => "minvmd"
    end

    resource("gvproxy").stage do
      bin.install "gvproxy-darwin-arm64" => "gvproxy-min"
    end

    resource("libkrun").stage do
      lib.install "libkrun-macos-arm64.dylib" => "libkrun.1.dylib"
    end

    generate_completions_from_executable bin/"min", "completions", "print",
                                         base_name: "min"
  end

  test do
    # Nightly binaries report a git-describe string, not the synthetic pkgver.
    assert_match "Usage", shell_output("#{bin}/min --help")
  end
end
