# GENERATED by scripts/render-packaging.sh from the gominimal/minimal packaging
# templates — do not hand edit in the tap.
class Minimal < Formula
  desc "Isolated, reproducible development environments and a secure package manager"
  homepage "https://minimal.dev"
  license "Apache-2.0"
  url "https://github.com/gominimal/minimal/releases/download/v@@VERSION@@/minimal-macos-arm64"
  sha256 "@@SHA256@@"

  # The macOS release is Apple Silicon only (no darwin x86_64 artifact exists).
  depends_on arch: :arm64

  # macOS VM support. minvmd links libkrun via @rpath/libkrun.1.dylib and
  # carries an @loader_path/../lib rpath (scripts/rewrite-macos-linkage.sh
  # retargets the release binary to exactly that shape), so it resolves the
  # library from THIS prefix's lib/ — a Cellar prefix sibling of bin/, not the
  # slp/krun formula's Cellar, which @loader_path can never reach. depends_on
  # pulls the formula in and gives the dylib its runtime deps; the resource
  # below installs the same trimmed dylib the installer drops (libkrun
  # -macos-arm64.dylib from the release assets) under the load command's
  # expected name, reproducing the installer's bin/lib sibling layout.
  depends_on "slp/krun/libkrun"

  resource "minvmd" do
    url "https://github.com/gominimal/minimal/releases/download/v@@VERSION@@/minvmd-macos-arm64"
    sha256 "@@SHA_MINVMD@@"
  end

  # The libkrun dylib minvmd loads. Basename MUST be libkrun.1.dylib: that is
  # minvmd's @rpath load command (see scripts/stage-release.sh's darwin table).
  resource "libkrun" do
    url "https://github.com/gominimal/minimal/releases/download/v@@VERSION@@/libkrun-macos-arm64.dylib"
    sha256 "@@SHA_LIBKRUN@@"
  end

  resource "gvproxy" do
    url "https://github.com/gominimal/minimal/releases/download/v@@VERSION@@/gvproxy-darwin-arm64"
    sha256 "@@SHA_GVPROXY@@"
  end

  def install
    # The release asset minimal-macos-arm64 is the `min` binary (the bin
    # target of the `minimal` crate, named for the crate in the release);
    # the installer installs it as `bin/min`. The hash form renames on
    # install: `bin.install "minimal-macos-arm64"` (no hash) would create a
    # directory named min/ with the binary inside it.
    bin.install "minimal-macos-arm64" => "min"

    # `git push min://<session>` resolves the min:// scheme to a
    # `git-remote-min` on PATH; `min` enters remote-helper mode from its
    # argv[0] basename, so the symlink to `min` is the whole helper — the
    # installer ships the same symlink with no separate artifact.
    ln_sf "min", bin/"git-remote-min"

    # minvmd boots the guest microVM; libkrun.1.dylib is staged into lib/
    # below (the @loader_path/../lib rpath above resolves it there). The
    # guest payload (kernel/rootfs/initramfs) is not in the formula: minvmd
    # resolves it from the minimal data dir ($XDG_DATA_HOME/minimal, else
    # ~/.local/share/minimal) — which the curl|sh install fills — or from the
    # MINVMD_KERNEL_PATH / MINVMD_ROOTFS_PATH / MINVMD_INITRAMFS overrides;
    # the release also publishes those arm64 artifacts.
    #
    # A staged resource block runs inside the staging directory, so the asset
    # basename is a plain relative path (there is no Mktemp#staging).
    resource("minvmd").stage do
      bin.install "minvmd-macos-arm64" => "minvmd"
    end

    # gvproxy-min is the VM network switch for own-IP sessions, installed
    # under the minimal-specific name minvmd/minimald look for (not
    # `gvproxy`: podman/crc ship their own there). minvmd resolves it from
    # $MINIMAL_BIN/~/.local/bin or a system path, so on a brew-only host set
    # MINVMD_GVPROXY_BIN="$(brew --prefix minimal)/bin/gvproxy-min".
    resource("gvproxy").stage do
      bin.install "gvproxy-darwin-arm64" => "gvproxy-min"
    end

    # The dylib goes into this prefix's lib/, the one directory minvmd's
    # @loader_path/../lib rpath actually searches. (The slp/krun dependency
    # installs its copy into ITS Cellar prefix, which @loader_path cannot
    # reach; Homebrew's opt symlinks do not help either — dyld resolves
    # @loader_path against the realpath of the installed binary.)
    resource("libkrun").stage do
      lib.install "libkrun-macos-arm64.dylib" => "libkrun.1.dylib"
    end

    # Completions: `min completions print <shell>` emits the shell's
    # registration shim on stdout — the same file `min completions install
    # <shell>` writes into the user's completion dirs — so the Homebrew
    # generate_completions_from_executable idiom applies: it runs the freshly
    # installed binary once per shell and stores the output in brew's standard
    # completion paths (etc/bash_completion.d, share/zsh/site-functions,
    # share/fish/vendor_completions.d). base_name is explicit because the
    # binary is `min` but the formula is `minimal`: the shims register the
    # command `min`, so the files must be min/_min/min.fish.
    generate_completions_from_executable bin/"min", "completions", "print",
                                         base_name: "min"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/min --version")
  end
end
