# pacman hook for minimal-bin: finish the host the way `min finalize-install`
# does when the package lands, as root and never prompting. The probe prints
# the one script a run would execute, only while something is missing (the
# minimald AppArmor profile on a host that restricts user namespaces, the
# classifier tree, ...), and root runs it directly: no sudo, no terminal. A
# miss here must never fail the pacman transaction: warn on stderr and return
# 0; `min finalize-install` retries the step later.

_finalize_install() {
    local script
    script="$(mktemp)" || return 0
    if /usr/bin/min finalize-install --show --script >"$script" 2>/dev/null &&
        [ -s "$script" ]; then
        sh "$script" ||
            printf '%s\n' \
                "warning: finishing the host setup failed." \
                "minimal is installed; run \`min finalize-install\` to retry" \
                "(\`min finalize-install --show\` names what is missing)." >&2
    fi
    rm -f "$script"
    return 0
}

post_install() {
    _finalize_install
}

post_upgrade() {
    _finalize_install
}
