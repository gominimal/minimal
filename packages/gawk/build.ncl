        {file = "prebuilt/usr/share/man/man3/readdir.3am"} | Local,
        {file = "prebuilt/usr/share/man/man3/readfile.3am"} | Local,
        {file = "prebuilt/usr/share/man/man3/revoutput.3am"} | Local,
        {file = "prebuilt/usr/share/man/man3/revtwoway.3am"} | Local,
        {file = "prebuilt/usr/share/man/man3/rwarray.3am"} | Local,
        {file = "prebuilt/usr/share/man/man3/time.3am"} | Local,
        busybox_static,
    ],
    cmd = "./build.sh",
    outputs = {
        usr_bin = { glob = "usr/bin/**/*" } | OutputLib,
        usr_include = { glob = "usr/include/**/*" } | OutputLib,
        usr_lib = { glob = "usr/lib/**/*" } | OutputLib,
        usr_libexec = { glob = "usr/libexec/**/*" } | OutputLib,
        usr_share = { glob = "usr/share/**/*" } | OutputLib,
    },
} | BuildSpec
