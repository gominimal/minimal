        {file = "prebuilt/usr/share/info/gawk_api-figure3.png"} | Local,
        {file = "prebuilt/usr/share/info/gawk_array-elements.png"} | Local,
        {file = "prebuilt/usr/share/info/gawk_general-program.png"} | Local,
        {file = "prebuilt/usr/share/info/gawkinet.info"} | Local,
