    cmd = "./build.sh",
    outputs = {
        # Core Linux headers
        linux_headers = { glob = "usr/include/linux/**/*" } | OutputLib,
        # Architecture-specific headers
        asm_headers = { glob = "usr/include/asm/**/*" } | OutputLib,
        asm_generic_headers = { glob = "usr/include/asm-generic/**/*" } | OutputLib,
        # DRM headers
        drm_headers = { glob = "usr/include/drm/**/*" } | OutputLib,
        # RDMA headers
        rdma_headers = { glob = "usr/include/rdma/**/*" } | OutputLib,
        # SCSI headers
        scsi_headers = { glob = "usr/include/scsi/**/*" } | OutputLib,
        # Sound headers
        sound_headers = { glob = "usr/include/sound/**/*" } | OutputLib,
        # Video headers
        video_headers = { glob = "usr/include/video/**/*" } | OutputLib,
        # Miscellaneous headers
        misc_headers = { glob = "usr/include/misc/**/*" } | OutputLib,
        mtd_headers = { glob = "usr/include/mtd/**/*" } | OutputLib,
        regulator_headers = { glob = "usr/include/regulator/**/*" } | OutputLib,
        xen_headers = { glob = "usr/include/xen/**/*" } | OutputLib,
    },
} | BuildSpec
