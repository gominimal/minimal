let {BuildSpec, HostPath, OutputLib, Local, ..} = import "minimal.ncl" in
let busybox_static = import "../busybox_static/build.ncl" in
{
    name = "xz",
    inputs = [
        {file = "build.sh"} | Local,
        # Binary files
        {file = "prebuilt/usr/bin/lzmainfo"} | Local,
        {file = "prebuilt/usr/bin/xzegrep"} | Local,
        {file = "prebuilt/usr/bin/unxz"} | Local,
        {file = "prebuilt/usr/bin/xzgrep"} | Local,
        {file = "prebuilt/usr/bin/xzdec"} | Local,
        {file = "prebuilt/usr/bin/lzma"} | Local,
        {file = "prebuilt/usr/bin/xzfgrep"} | Local,
        {file = "prebuilt/usr/bin/lzgrep"} | Local,
        {file = "prebuilt/usr/bin/xzdiff"} | Local,
        {file = "prebuilt/usr/bin/lzdiff"} | Local,
        {file = "prebuilt/usr/bin/xzless"} | Local,
        {file = "prebuilt/usr/bin/lzless"} | Local,
        {file = "prebuilt/usr/bin/lzcat"} | Local,
        {file = "prebuilt/usr/bin/xz"} | Local,
        {file = "prebuilt/usr/bin/lzfgrep"} | Local,
        {file = "prebuilt/usr/bin/xzcmp"} | Local,
        {file = "prebuilt/usr/bin/lzegrep"} | Local,
        {file = "prebuilt/usr/bin/lzcmp"} | Local,
        {file = "prebuilt/usr/bin/lzmore"} | Local,
        {file = "prebuilt/usr/bin/xzmore"} | Local,
        {file = "prebuilt/usr/bin/xzcat"} | Local,
        {file = "prebuilt/usr/bin/lzmadec"} | Local,
        {file = "prebuilt/usr/bin/unlzma"} | Local,
        # Library files
        {file = "prebuilt/usr/lib/liblzma.so"} | Local,
        {file = "prebuilt/usr/lib/liblzma.so.5"} | Local,
        {file = "prebuilt/usr/lib/liblzma.so.5.8.1"} | Local,
        # Header files
        {file = "prebuilt/usr/include/lzma/index_hash.h"} | Local,
        {file = "prebuilt/usr/include/lzma/container.h"} | Local,
        {file = "prebuilt/usr/include/lzma/base.h"} | Local,
        {file = "prebuilt/usr/include/lzma/lzma12.h"} | Local,
        {file = "prebuilt/usr/include/lzma/version.h"} | Local,
        {file = "prebuilt/usr/include/lzma/stream_flags.h"} | Local,
        {file = "prebuilt/usr/include/lzma/delta.h"} | Local,
        {file = "prebuilt/usr/include/lzma/index.h"} | Local,
        {file = "prebuilt/usr/include/lzma/vli.h"} | Local,
        {file = "prebuilt/usr/include/lzma/check.h"} | Local,
        {file = "prebuilt/usr/include/lzma/filter.h"} | Local,
        {file = "prebuilt/usr/include/lzma/hardware.h"} | Local,
        {file = "prebuilt/usr/include/lzma/block.h"} | Local,
        {file = "prebuilt/usr/include/lzma/bcj.h"} | Local,
        {file = "prebuilt/usr/include/lzma.h"} | Local,
        busybox_static,
    ],
    cmd = "./build.sh",
    outputs = {
        usr_bin = { glob = "usr/bin/**/*" } | OutputLib,
        usr_lib = { glob = "usr/lib/**/*" } | OutputLib,
        usr_include = { glob = "usr/include/**/*" } | OutputLib,
    },
} | BuildSpec
