let {BuildSpec, HostPath, OutputLib, Local, ..} = import "minimal.ncl" in
let busybox_static = import "../busybox_static/build.ncl" in
let host_make = import "../host_make/build.ncl" in
{
    name = "xz",
    inputs = [
        {file = "build.sh"} | Local,
        {file = "xz-5.8.1.tar.xz"} | Local,
        busybox_static,
        host_make,
    ],
    cmd = "./build.sh",
    outputs = {
        xz_bin = { glob = "bin/xz" } | OutputLib,
        xzcat = { glob = "bin/xzcat" } | OutputLib,
        xzcmp = { glob = "bin/xzcmp" } | OutputLib,
        xzdec = { glob = "bin/xzdec" } | OutputLib,
        xzdiff = { glob = "bin/xzdiff" } | OutputLib,
        xzegrep = { glob = "bin/xzegrep" } | OutputLib,
        xzfgrep = { glob = "bin/xzfgrep" } | OutputLib,
        xzgrep = { glob = "bin/xzgrep" } | OutputLib,
        xzless = { glob = "bin/xzless" } | OutputLib,
        xzmore = { glob = "bin/xzmore" } | OutputLib,
        lzcat = { glob = "bin/lzcat" } | OutputLib,
        lzcmp = { glob = "bin/lzcmp" } | OutputLib,
        lzdiff = { glob = "bin/lzdiff" } | OutputLib,
        lzegrep = { glob = "bin/lzegrep" } | OutputLib,
        lzfgrep = { glob = "bin/lzfgrep" } | OutputLib,
        lzgrep = { glob = "bin/lzgrep" } | OutputLib,
        lzless = { glob = "bin/lzless" } | OutputLib,
        lzma = { glob = "bin/lzma" } | OutputLib,
        lzmadec = { glob = "bin/lzmadec" } | OutputLib,
        lzmainfo = { glob = "bin/lzmainfo" } | OutputLib,
        lzmore = { glob = "bin/lzmore" } | OutputLib,
        unlzma = { glob = "bin/unlzma" } | OutputLib,
        unxz = { glob = "bin/unxz" } | OutputLib,
        liblzma = { glob = "lib/liblzma.so*" } | OutputLib,
        headers = { glob = "include/lzma.h" } | OutputLib,
        lzma_headers = { glob = "include/lzma/*.h" } | OutputLib,
    },
} | BuildSpec
