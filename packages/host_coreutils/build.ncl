let {BuildSpec, HostPath, OutputLib, Local, ..} = import "minimal.ncl" in
let host_bash = import "../host_bash/build.ncl" in
{
    name = "host_coreutils",
    inputs = [
        {file = "build.sh"} | Local,
        {path = "/usr/bin/["} | HostPath,
        {path = "/usr/bin/arch"} | HostPath,
        {path = "/usr/bin/b2sum"} | HostPath,
        {path = "/usr/bin/base32"} | HostPath,
        {path = "/usr/bin/base64"} | HostPath,
        {path = "/usr/bin/basename"} | HostPath,
        {path = "/usr/bin/basenc"} | HostPath,
        {path = "/usr/bin/cat"} | HostPath,
        {path = "/usr/bin/chcon"} | HostPath,
        {path = "/usr/bin/chgrp"} | HostPath,
        {path = "/usr/bin/chmod"} | HostPath,
        {path = "/usr/bin/chown"} | HostPath,
        {path = "/usr/bin/cksum"} | HostPath,
        {path = "/usr/bin/cmp"} | HostPath,
        {path = "/usr/bin/comm"} | HostPath,
        {path = "/usr/bin/cp"} | HostPath,
        {path = "/usr/bin/csplit"} | HostPath,
        {path = "/usr/bin/cut"} | HostPath,
        {path = "/usr/bin/date"} | HostPath,
        {path = "/usr/bin/dd"} | HostPath,
        {path = "/usr/bin/df"} | HostPath,
        {path = "/usr/bin/dir"} | HostPath,
        {path = "/usr/bin/dircolors"} | HostPath,
        {path = "/usr/bin/dirname"} | HostPath,
        {path = "/usr/bin/du"} | HostPath,
        {path = "/usr/bin/echo"} | HostPath,
        {path = "/usr/bin/env"} | HostPath,
        {path = "/usr/bin/expand"} | HostPath,
        {path = "/usr/bin/expr"} | HostPath,
        {path = "/usr/bin/factor"} | HostPath,
        {path = "/usr/bin/false"} | HostPath,
        {path = "/usr/bin/fmt"} | HostPath,
        {path = "/usr/bin/fold"} | HostPath,
        {path = "/usr/bin/groups"} | HostPath,
        {path = "/usr/bin/head"} | HostPath,
        {path = "/usr/bin/hostid"} | HostPath,
        {path = "/usr/bin/id"} | HostPath,
        {path = "/usr/bin/install"} | HostPath,
        {path = "/usr/bin/join"} | HostPath,
        {path = "/usr/bin/link"} | HostPath,
        {path = "/usr/bin/ln"} | HostPath,
        {path = "/usr/bin/logname"} | HostPath,
        {path = "/usr/bin/ls"} | HostPath,
        {path = "/usr/bin/md5sum"} | HostPath,
        {path = "/usr/bin/mkdir"} | HostPath,
        {path = "/usr/bin/mkfifo"} | HostPath,
        {path = "/usr/bin/mknod"} | HostPath,
        {path = "/usr/bin/mktemp"} | HostPath,
        {path = "/usr/bin/mv"} | HostPath,
        {path = "/usr/bin/nice"} | HostPath,
        {path = "/usr/bin/nl"} | HostPath,
        {path = "/usr/bin/nohup"} | HostPath,
        {path = "/usr/bin/nproc"} | HostPath,
        {path = "/usr/bin/numfmt"} | HostPath,
        {path = "/usr/bin/od"} | HostPath,
        {path = "/usr/bin/paste"} | HostPath,
        {path = "/usr/bin/pathchk"} | HostPath,
        {path = "/usr/bin/pinky"} | HostPath,
        {path = "/usr/bin/pr"} | HostPath,
        {path = "/usr/bin/printenv"} | HostPath,
        {path = "/usr/bin/printf"} | HostPath,
        {path = "/usr/bin/ptx"} | HostPath,
        {path = "/usr/bin/pwd"} | HostPath,
        {path = "/usr/bin/readlink"} | HostPath,
        {path = "/usr/bin/realpath"} | HostPath,
        {path = "/usr/bin/rm"} | HostPath,
        {path = "/usr/bin/rmdir"} | HostPath,
        {path = "/usr/bin/runcon"} | HostPath,
        {path = "/usr/bin/seq"} | HostPath,
        {path = "/usr/bin/sha1sum"} | HostPath,
        {path = "/usr/bin/sha224sum"} | HostPath,
        {path = "/usr/bin/sha256sum"} | HostPath,
        {path = "/usr/bin/sha384sum"} | HostPath,
        {path = "/usr/bin/sha512sum"} | HostPath,
        {path = "/usr/bin/shred"} | HostPath,
        {path = "/usr/bin/shuf"} | HostPath,
        {path = "/usr/bin/sleep"} | HostPath,
        {path = "/usr/bin/sort"} | HostPath,
        {path = "/usr/bin/split"} | HostPath,
        {path = "/usr/bin/stat"} | HostPath,
        {path = "/usr/bin/stdbuf"} | HostPath,
        {path = "/usr/bin/stty"} | HostPath,
        {path = "/usr/bin/sum"} | HostPath,
        {path = "/usr/bin/sync"} | HostPath,
        {path = "/usr/bin/tac"} | HostPath,
        {path = "/usr/bin/tail"} | HostPath,
        {path = "/usr/bin/tee"} | HostPath,
        {path = "/usr/bin/test"} | HostPath,
        {path = "/usr/bin/timeout"} | HostPath,
        {path = "/usr/bin/touch"} | HostPath,
        {path = "/usr/bin/tr"} | HostPath,
        {path = "/usr/bin/true"} | HostPath,
        {path = "/usr/bin/truncate"} | HostPath,
        {path = "/usr/bin/tsort"} | HostPath,
        {path = "/usr/bin/tty"} | HostPath,
        {path = "/usr/bin/uname"} | HostPath,
        {path = "/usr/bin/unexpand"} | HostPath,
        {path = "/usr/bin/uniq"} | HostPath,
        {path = "/usr/bin/unlink"} | HostPath,
        {path = "/usr/bin/users"} | HostPath,
        {path = "/usr/bin/vdir"} | HostPath,
        {path = "/usr/bin/wc"} | HostPath,
        {path = "/usr/bin/who"} | HostPath,
        {path = "/usr/bin/whoami"} | HostPath,
        {path = "/usr/bin/yes"} | HostPath,
        host_bash,
    ],
    cmd = "./build.sh",
    outputs = {
        coreutils = { glob = "bin/*" } | OutputLib,
    },
} | BuildSpec
