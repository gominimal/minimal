From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Minimal <noreply@minimal.dev>
Date: Sat, 31 Oct 2026 00:00:00 +0000
Subject: [PATCH] forwarder: unexpose closes the connections a forward accepted

PortsForwarder.Unexpose closes a forward's listener and nothing else, so a
connection the forward accepted before the unexpose stays open after the
port is withdrawn. Minimal withdraws a box's published port and expects the
connections through it to end with it.

Wrap each TCP and unix forward's tcpproxy.DialProxy in a target that records
every connection the route accepts and forgets it when its handler returns.
UnexposeClosing closes the listener and then every connection that forward
still holds, logs the count, and returns it. Unexpose keeps its signature and
calls UnexposeClosing. The /unexpose reply carries {"closed":<n>}. A forward
at another local address to the same remote keeps its connections.

Both changed files carry a notice that they were modified, as section 4(b)
of the Apache License 2.0 asks.

Applies to containers/gvisor-tap-vsock v0.9.0
(6dbb5d4fa0033356c72a201346f8350594229868).
---
diff --git a/pkg/services/forwarder/ports.go b/pkg/services/forwarder/ports.go
index 1fb8f4f52855..78dec6a5f171 100644
--- a/pkg/services/forwarder/ports.go
+++ b/pkg/services/forwarder/ports.go
@@ -1,3 +1,6 @@
+// Modified by gominimal/minimal (vendor/gvproxy/patches/0001): Unexpose
+// closes the connections a forward accepted, and /unexpose reports how many.
+
 package forwarder
 
 import (
@@ -39,6 +42,67 @@ type proxy struct {
 	Remote     string `json:"remote"`
 	Protocol   string `json:"protocol"`
 	underlying io.Closer
+	// accepted holds the connections this forward accepted and still
+	// serves. It is nil for a UDP forward, which accepts no connections.
+	accepted *acceptedConns
+}
+
+// acceptedConns records every connection one forward's route accepted, and
+// forgets each one when its handler returns. Closing the listener stops new
+// connections only, so Unexpose closes these as well.
+type acceptedConns struct {
+	mu     sync.Mutex
+	conns  map[net.Conn]struct{}
+	closed bool
+}
+
+func newAcceptedConns() *acceptedConns {
+	return &acceptedConns{conns: make(map[net.Conn]struct{})}
+}
+
+// track wraps target so that each connection it handles is recorded for the
+// lifetime of the handler.
+func (a *acceptedConns) track(target tcpproxy.Target) tcpproxy.Target {
+	return trackedTarget{conns: a, target: target}
+}
+
+// closeAll closes every connection still recorded and returns how many it
+// closed. A connection accepted after closeAll is closed at once.
+func (a *acceptedConns) closeAll() int {
+	a.mu.Lock()
+	a.closed = true
+	conns := make([]net.Conn, 0, len(a.conns))
+	for c := range a.conns {
+		conns = append(conns, c)
+	}
+	a.conns = make(map[net.Conn]struct{})
+	a.mu.Unlock()
+	for _, c := range conns {
+		_ = c.Close()
+	}
+	return len(conns)
+}
+
+type trackedTarget struct {
+	conns  *acceptedConns
+	target tcpproxy.Target
+}
+
+func (t trackedTarget) HandleConn(c net.Conn) {
+	t.conns.mu.Lock()
+	if t.conns.closed {
+		t.conns.mu.Unlock()
+		_ = c.Close()
+		return
+	}
+	t.conns.conns[c] = struct{}{}
+	t.conns.mu.Unlock()
+	defer func() {
+		t.conns.mu.Lock()
+		delete(t.conns.conns, c)
+		t.conns.mu.Unlock()
+	}()
+	t.target.HandleConn(c)
 }
 
 type gonetDialer struct {
@@ -172,10 +236,11 @@ func (f *PortsForwarder) Expose(protocol types.TransportProtocol, local, remote
 				return sshclient.ListenNpipe(npipeURI)
 			}
 		}
-		p.AddRoute(local, &tcpproxy.DialProxy{
+		accepted := newAcceptedConns()
+		p.AddRoute(local, accepted.track(&tcpproxy.DialProxy{
 			Addr:        remoteAddr,
 			DialContext: dialFn,
-		})
+		}))
 		if err := p.Start(); err != nil {
 			return err
 		}
@@ -199,6 +264,7 @@ func (f *PortsForwarder) Expose(protocol types.TransportProtocol, local, remote
 				}
 				return p.Close()
 			}),
+			accepted: accepted,
 		}
 	case types.UDP:
 		address, err := tcpipAddress(1, remote)
@@ -238,7 +304,8 @@ func (f *PortsForwarder) Expose(protocol types.TransportProtocol, local, remote
 		}
 
 		var p tcpproxy.Proxy
-		p.AddRoute(local, &tcpproxy.DialProxy{
+		accepted := newAcceptedConns()
+		p.AddRoute(local, accepted.track(&tcpproxy.DialProxy{
 			Addr: remote,
 			DialContext: func(ctx context.Context, _, _ string) (conn net.Conn, e error) {
 				var bindAddr tcpip.FullAddress
@@ -249,7 +316,7 @@ func (f *PortsForwarder) Expose(protocol types.TransportProtocol, local, remote
 				}
 				return gonet.DialTCPWithBind(ctx, f.stack, bindAddr, address, ipv4.ProtocolNumber)
 			},
-		})
+		}))
 		if err := p.Start(); err != nil {
 			return err
 		}
@@ -263,6 +330,7 @@ func (f *PortsForwarder) Expose(protocol types.TransportProtocol, local, remote
 			Local:      local,
 			Remote:     remote,
 			underlying: &p,
+			accepted:   accepted,
 		}
 	default:
 		return fmt.Errorf("unknown protocol %s", protocol)
@@ -275,14 +343,35 @@ func key(protocol types.TransportProtocol, local string) ProxyKey {
 }
 
 func (f *PortsForwarder) Unexpose(protocol types.TransportProtocol, local string) error {
+	_, err := f.UnexposeClosing(protocol, local)
+	return err
+}
+
+// UnexposeClosing removes the forward at local: it closes the listener and
+// then every connection that forward accepted and still holds. It returns
+// how many connections it closed. A forward at another local to the same
+// remote keeps its connections.
+func (f *PortsForwarder) UnexposeClosing(protocol types.TransportProtocol, local string) (int, error) {
 	f.proxiesLock.Lock()
 	defer f.proxiesLock.Unlock()
 	proxy, ok := f.proxies[key(protocol, local)]
 	if !ok {
-		return errors.New("proxy not found")
+		return 0, errors.New("proxy not found")
 	}
 	delete(f.proxies, key(protocol, local))
-	return proxy.underlying.Close()
+	err := proxy.underlying.Close()
+	closed := 0
+	if proxy.accepted != nil {
+		closed = proxy.accepted.closeAll()
+	}
+	log.Infof("unexposed %s %s: closed %d accepted connections", protocol, local, closed)
+	return closed, err
+}
+
+// UnexposeResponse is the /unexpose reply: how many accepted connections
+// the removed forward closed.
+type UnexposeResponse struct {
+	Closed int `json:"closed"`
 }
 
 func (f *PortsForwarder) Close() error {
@@ -372,11 +461,17 @@ func (f *PortsForwarder) Mux() http.Handler {
 		apilog.AddField(r, "protocol", req.Protocol)
 		apilog.AddField(r, "local", req.Local)
 
-		if err := f.Unexpose(req.Protocol, req.Local); err != nil {
+		closed, err := f.UnexposeClosing(req.Protocol, req.Local)
+		if err != nil {
 			http.Error(w, err.Error(), http.StatusInternalServerError)
 			return
 		}
+		apilog.AddField(r, "closed", closed)
+		w.Header().Set("Content-Type", "application/json")
 		w.WriteHeader(http.StatusOK)
+		if err := json.NewEncoder(w).Encode(UnexposeResponse{Closed: closed}); err != nil {
+			apilog.SetError(r, err)
+		}
 	})
 	return mux
 }
diff --git a/pkg/services/forwarder/unexpose_test.go b/pkg/services/forwarder/unexpose_test.go
new file mode 100644
index 000000000000..d7afc326be18
--- /dev/null
+++ b/pkg/services/forwarder/unexpose_test.go
@@ -0,0 +1,178 @@
+// Added by gominimal/minimal (vendor/gvproxy/patches/0001): proves that
+// Unexpose closes only the connections its own forward accepted.
+
+package forwarder
+
+import (
+	"bufio"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/containers/gvisor-tap-vsock/pkg/types"
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/adapters/gonet"
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+	"gvisor.dev/gvisor/pkg/tcpip/link/loopback"
+	"gvisor.dev/gvisor/pkg/tcpip/network/ipv4"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+	"gvisor.dev/gvisor/pkg/tcpip/transport/tcp"
+)
+
+// unexposeStack is a gvisor stack with one NIC that holds the guest address.
+func unexposeStack(t *testing.T) *stack.Stack {
+	t.Helper()
+	s := stack.New(stack.Options{
+		NetworkProtocols:   []stack.NetworkProtocolFactory{ipv4.NewProtocol},
+		TransportProtocols: []stack.TransportProtocolFactory{tcp.NewProtocol},
+	})
+	if err := s.CreateNIC(1, loopback.New()); err != nil {
+		t.Fatalf("create NIC: %v", err)
+	}
+	for _, addr := range []tcpip.Address{gatewayIP, childIP} {
+		if err := s.AddProtocolAddress(1, tcpip.ProtocolAddress{
+			Protocol:          ipv4.ProtocolNumber,
+			AddressWithPrefix: addr.WithPrefix(),
+		}, stack.AddressProperties{}); err != nil {
+			t.Fatalf("add address %v: %v", addr, err)
+		}
+	}
+	s.SetSpoofing(1, true)
+	s.SetPromiscuousMode(1, true)
+	s.SetRouteTable([]tcpip.Route{{Destination: header.IPv4EmptySubnet, NIC: 1}})
+	return s
+}
+
+func freeLoopbackAddr(t *testing.T) string {
+	t.Helper()
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("listen: %v", err)
+	}
+	addr := ln.Addr().String()
+	_ = ln.Close()
+	return addr
+}
+
+// echoOnce writes one line on c and reads it back through the guest's echo
+// server.
+func echoOnce(c net.Conn, r *bufio.Reader, line string) error {
+	if err := c.SetDeadline(time.Now().Add(5 * time.Second)); err != nil {
+		return err
+	}
+	if _, err := io.WriteString(c, line+"\n"); err != nil {
+		return err
+	}
+	got, err := r.ReadString('\n')
+	if err != nil {
+		return err
+	}
+	if strings.TrimSpace(got) != line {
+		return errors.New("echo returned " + got)
+	}
+	return nil
+}
+
+// A forward that is unexposed closes the connections it accepted. A second
+// forward, at another local address to the same guest port, keeps its own
+// connection, and the /unexpose reply says how many connections closed.
+func TestUnexposeClosesOnlyItsOwnAcceptedConnections(t *testing.T) {
+	s := unexposeStack(t)
+	guest, err := gonet.ListenTCP(s, tcpip.FullAddress{NIC: 1, Addr: childIP, Port: 8080}, ipv4.ProtocolNumber)
+	if err != nil {
+		t.Fatalf("guest listen: %v", err)
+	}
+	defer guest.Close()
+	go func() {
+		for {
+			c, err := guest.Accept()
+			if err != nil {
+				return
+			}
+			go func() {
+				defer c.Close()
+				_, _ = io.Copy(c, c)
+			}()
+		}
+	}()
+
+	fw := NewPortsForwarder(s)
+	defer fw.Close()
+	retracted := freeLoopbackAddr(t)
+	sibling := freeLoopbackAddr(t)
+	remote := childIP.String() + ":8080"
+	for _, local := range []string{retracted, sibling} {
+		if err := fw.Expose(types.TCP, local, remote); err != nil {
+			t.Fatalf("expose %s: %v", local, err)
+		}
+	}
+
+	dial := func(local string) (net.Conn, *bufio.Reader) {
+		c, err := net.DialTimeout("tcp", local, 5*time.Second)
+		if err != nil {
+			t.Fatalf("dial %s: %v", local, err)
+		}
+		r := bufio.NewReader(c)
+		if err := echoOnce(c, r, "hello "+local); err != nil {
+			t.Fatalf("echo through %s: %v", local, err)
+		}
+		return c, r
+	}
+	retractedConn, retractedReader := dial(retracted)
+	defer retractedConn.Close()
+	siblingConn, siblingReader := dial(sibling)
+	defer siblingConn.Close()
+
+	body, err := json.Marshal(types.UnexposeRequest{Local: retracted, Protocol: types.TCP})
+	if err != nil {
+		t.Fatal(err)
+	}
+	rec := httptest.NewRecorder()
+	fw.Mux().ServeHTTP(rec, httptest.NewRequest(http.MethodPost, "/unexpose", strings.NewReader(string(body))))
+	if rec.Code != http.StatusOK {
+		t.Fatalf("/unexpose answered %d: %s", rec.Code, rec.Body.String())
+	}
+	var reply UnexposeResponse
+	if err := json.Unmarshal(rec.Body.Bytes(), &reply); err != nil {
+		t.Fatalf("/unexpose reply %q: %v", rec.Body.String(), err)
+	}
+	if reply.Closed != 1 {
+		t.Fatalf("/unexpose closed %d connections, want 1", reply.Closed)
+	}
+
+	// The retracted forward's connection ends: a read sees EOF or a reset,
+	// never a timeout.
+	if err := retractedConn.SetReadDeadline(time.Now().Add(5 * time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := retractedReader.ReadByte(); err == nil {
+		t.Fatal("the retracted forward's connection still delivers bytes")
+	} else if errors.Is(err, os.ErrDeadlineExceeded) {
+		t.Fatal("the retracted forward's connection stayed open")
+	}
+	if c, err := net.DialTimeout("tcp", retracted, time.Second); err == nil {
+		_ = c.Close()
+		t.Fatal("the retracted forward still accepts connections")
+	}
+
+	// The sibling forward's connection keeps working.
+	if err := echoOnce(siblingConn, siblingReader, "still here"); err != nil {
+		t.Fatalf("the sibling forward's connection broke: %v", err)
+	}
+
+	// Unexposing the sibling reports its own connection only.
+	closed, err := fw.UnexposeClosing(types.TCP, sibling)
+	if err != nil {
+		t.Fatalf("unexpose sibling: %v", err)
+	}
+	if closed != 1 {
+		t.Fatalf("sibling unexpose closed %d connections, want 1", closed)
+	}
+}
