# minimal.toml vocabulary (crates/mfile/src/lib.rs serde structs).
s_upstream="[upstream]"
s_stack="[stack]"
s_session="[session]"
s_defaults="[defaults]"
s_sideload="[sideload]"
k_repo="repo = \""
k_branch="branch = \""
k_locked="locked_commit = \""
k_use="use = \""
k_link="link"
k_profile="profile"
k_state_key="state_key"
k_name="name"
k_build_packages="build_packages"
k_runtime_packages="runtime_packages"
k_packages="packages"
k_vars="vars"
k_patches="patches"
k_lifecycle_hooks="lifecycle_hooks"
k_env="env"
k_dir="dir"
k_file="file"
k_entrypoint="entrypoint"
k_cmd="cmd"
k_type="type = \""
# TOML syntax
t_table_open="[["
t_table_close="]]"
t_dotted=".\""
t_multiline="\"\"\""
t_inline_tbl="{ }"
t_eq=" = "
