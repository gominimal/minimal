(version 3)
(deny default)

(import "system.sb")

(allow process-fork)
(allow process-info* (target self))
(allow system-mac-syscall (mac-policy-name "AMFI"))
(allow syscall-mach)
(allow syscall-unix)

(allow file-read-metadata)
(allow file-test-existence)

(allow file-read* file-write*
    (subpath (param "_TMPDIR"))
)
