target/

# minvmd local dev scratch (kernel/rootfs materialized for local boot)
.scratch/

# Claude Code / git worktree scratch dirs (agent worktrees, embedded repos)
.claude/
.worktrees/

# Finder metadata. macOS is a first-class dev platform here, so these appear in
# every directory anyone browses; unignored, a wide `git add` sweeps them in.
.DS_Store

# CPython bytecode. The repo ships Python helpers (scripts/, docs/spikes/);
# running one leaves a __pycache__ beside it that a wide `git add` sweeps in.
__pycache__/
*.pyc

# just pkg-nfpm default OUT_DIR (scripts/package-nfpm.sh)
/dist/

# Vale prose-linting: the synced styles are rebuilt by `vale sync`, and the
# sync-generated config lands under them. The rules live in
# gominimal/prose-rules.
/styles/
